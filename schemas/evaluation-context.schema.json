{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/evaluation-context.schema.json",
  "title": "Harbor DSH Evaluation Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "digest",
    "dataset_digest",
    "file_count",
    "tasks",
    "harbor_version",
    "integration_version",
    "integration_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dataset_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file_count": { "type": "integer", "minimum": 0 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "name", "version"],
        "properties": {
          "path": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "harbor_version": { "type": "string", "minLength": 1 },
    "integration_version": { "type": "string", "minLength": 1 },
    "integration_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
