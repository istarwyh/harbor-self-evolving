{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/candidate-manifest.schema.json",
  "title": "Harbor DSH Candidate Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "version", "digest", "created_at", "runtime", "files", "metadata"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "transport"],
      "properties": {
        "kind": { "const": "deepseek-harness" },
        "version": { "type": "string", "minLength": 1 },
        "transport": { "const": "acp" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
