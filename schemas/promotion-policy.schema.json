{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/promotion-policy.schema.json",
  "title": "Harbor DSH Promotion Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "primary_metric"],
  "properties": {
    "schema_version": { "const": 1 },
    "primary_metric": { "type": "string", "minLength": 1 },
    "min_improvement": { "type": "number", "default": 0 },
    "minimums": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "default": {}
    },
    "non_regression": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "non_regression_tolerance": { "type": "number", "minimum": 0, "default": 0 }
  }
}
