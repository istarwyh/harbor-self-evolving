{
  "schema_version": 1,
  "interface": "harbor-dsh-evaluator/v1",
  "evaluator_id": "deep-research-verifier",
  "version": "4.0.0",
  "kind": "script",
  "protocol": {
    "input": "evaluation-input/v1",
    "output": "evaluation-result/v1"
  },
  "implementation": {
    "entry": "evaluator.py",
    "language": "python",
    "callable": "evaluate"
  },
  "editable_files": [
    {
      "path": "evaluator.py",
      "role": "implementation",
      "language": "python",
      "affects": ["evaluator"]
    },
    {
      "path": "rubric.md",
      "role": "rubric",
      "language": "markdown",
      "affects": ["evaluator", "rubric"]
    }
  ],
  "criteria": [
    { "id": "response_quality", "label": "回应问题", "values": [0, 0.5, 1] },
    { "id": "interestingness", "label": "有趣性", "values": [0, 0.5, 1] },
    { "id": "citation_compliance", "label": "引用规范性", "values": [0, 0.5, 1] }
  ],
  "aggregate": {
    "metric_id": "reward",
    "method": "mean"
  }
}
